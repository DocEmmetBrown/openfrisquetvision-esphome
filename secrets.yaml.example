# Copier ce fichier en secrets.yaml (jamais commité) et le remplir.
wifi_ssid: "MonWiFi"
wifi_password: "mot-de-passe-wifi"
# Clé de chiffrement de l'API ESPHome : 32 octets en base64, par exemple générée par `openssl rand -base64 32`.
# Home Assistant la demande quand il découvre la carte.
api_key: "remplacer-par-une-cle-base64"
ota_password: "remplacer-par-un-mot-de-passe"
